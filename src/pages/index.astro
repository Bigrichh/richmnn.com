---
import BaseLayout from "../layouts/BaseLayout.astro";

import DesktopNav from "../components/DesktopNav.astro";
import MobileNav from "../components/MobileNav.astro";
import MusicPlayer1 from "../components/MusicPlayer1.astro";
import HeroAnimation from "../components/HeroAnimation.astro";

const pageTitle = "Home";
const pageDescription =
  "Richmann - Design Engineer - designing clean, thouhtful user experiences and building the tech bringing those experiences to life.";
const ogURL = "https://richmnn.com";
const keywords =
  "Richmann Addai, software engineer, design engineer, web development, product designer, UI/UX design, technology solutions, user experiences, entrepreneurial projects, Utopia Tech, personal projects, software development, design and development, software products";
---

<BaseLayout
  pageTitle={pageTitle}
  pageDescription={pageDescription}
  ogURL={ogURL}
  keywords={keywords}
>
  <!-- Hero section -->
  <section
    class="w-full h-[100vh] flex flex-col items-center pt-[220px] md:pt-[200px] lg:pt-[160px] relative"
  >
    <!-- Navigation -->
    <div class="absolute top-0 left-0 w-full z-50 block lg:hidden">
      <MobileNav />
    </div>

    <div class="w-fit flex flex-col gap-[32px] items-center">
      <!-- Header Intro Text -->
      <div class="w-[342px] md:w-fit flex flex-col gap-[4px] text-center">
        <h1 class="text-primary">The Internet Corner of Richmann Addai</h1>
        <h2 class="text-secondary">
          Design Engineer ( Product Design x Web Development )
        </h2>
      </div>
      <!-- Animated Images -->
      <div class="w-fit ">
        <HeroAnimation />
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <section class="flex flex-col md:flex-row mt-[160px] lg:mt-[200px]">
    <!-- Outer wrapper: 1st & 2nd columns -->
    <div class="flex w-full md:w-1/2 border-[0.5px] border-bdprimary">
      <!-- First Column (Navigation, Links, Music & Status) -->
      <div class="w-1/3 h-[99.5vh] hidden lg:flex flex-col">
        <!-- Top half: Personal info + navigation links -->
        <div class="w-full h-1/2">
          <DesktopNav />
        </div>
        <!-- Bottom half: Music Player + Status -->
        <div
          class="w-full h-1/2 p-[32px] flex flex-col justify-between border-[0.5px] border-bdprimary"
        >
          <!-- MUSIC PLAYER -->
          <div class="w-full">
            <MusicPlayer1 />
          </div>

          <!-- AVAILABILITY / STATUS -->
          <div class="w-full flex flex-col gap-[4px]">
            <h2 class="text-primary">Availability</h2>
            <p class="text-secondary">Last updated 01-08-2025</p>
            <div class="flex items-center gap-[4px]">
              <div
                class="status-dot size-[10px] bg-[#008000] rounded-full flex items-center justify-center"
              >
                <div class="inner-dot size-[4px] bg-[#28FF28] rounded-full">
                </div>
              </div>
              <p class="text-secondary">Looking for my next role</p>
            </div>
          </div>
        </div>
      </div>
      <!-- Second Column (Main Intro Text) -->
      <div
        class="w-full lg:w-2/3 h-fit md:h-[99.5vh] p-[32px] border-[0.5px] border-bdprimary border-r-transparent"
      >
        <!-- Personal Intro praragraph -->
        <p class="w-full text-primary">
          Hi, I’m Richmann. <br /> I’m a designer who codes, or a Developer who designs,
          if you must. What you’d call a design engineer. <br />
          <br /> I design and build digital products that feel simple, useful, and
          intentional. My work lives at the intersection of design and code, usually
          on the frontend from well designed interfaces to production-ready code.
          <br />
          <br /> You’ll find my work split into three parts. Choose the one that
          fits what you’re looking for.
        </p>
      </div>
    </div>

    <!-- Third column (list of links) -->
    <div
      class="w-full md:w-1/2 flex flex-col border-t-[0.5px] border-t-bdprimary pb-[120px] md:pb-0"
    >
      <!-- Design portfolio -->
      <a
        href="https://design.richmnn.com/"
        target="_blank"
        class="w-full p-[32px] flex items-center justify-between border-[0.5px] border-bdprimary text-primary hover:border-primary"
      >
        <p>Product Design</p>
        <p>design.richmnn.com</p>
      </a>
      <!-- Dev portfolio -->
      <a
        class="w-full p-[32px] flex items-center justify-between border-[0.5px] border-bdprimary text-primary hover:border-primary"
      >
        <p>Software Development</p>
        <p>Coming Soon</p>
      </a>
      <!-- Freelance portfolio -->
      <a
        class="w-full p-[32px] flex items-center justify-between border-[0.5px] border-bdprimary text-primary hover:border-primary"
      >
        <p>Freelance Studio</p>
        <p>Coming Soon</p>
      </a>
      <!-- Mail -->
      <a
        href="mailto:richmanaddai@gmail.com"
        class="w-full p-[32px] flex items-center justify-between border-[0.5px] border-bdprimary text-primary hover:border-primary"
      >
        <p>Mail</p>
        <p>richmanaddai@gmail.com</p>
      </a>
      <!-- LinkedIn -->
      <a
        href="https://linkedin.com/in/richmnn"
        target="_blank"
        class="w-full p-[32px] flex items-center justify-between border-[0.5px] border-bdprimary text-primary hover:border-primary"
      >
        <p>LinkedIn</p>
        <p>linkedin.com/in/richmnn</p>
      </a>
      <!-- GitHub -->
      <a
        href="https://github.com/Bigrichh"
        target="_blank"
        class="w-full p-[32px] flex items-center justify-between border-[0.5px] border-bdprimary text-primary hover:border-primary"
      >
        <p>Github</p>
        <p>github.com/Bigrichh</p>
      </a>
      <!-- Instagram -->
      <a
        href="https://instagram.com/big.richhhh"
        target="_blank"
        class="w-full p-[32px] flex items-center justify-between border-[0.5px] border-bdprimary text-primary hover:border-primary"
      >
        <p>Instagram</p>
        <p>instagram.com/big.richhhh</p>
      </a>
    </div>
  </section>
</BaseLayout>


<style is:global>


  /* -------------------------------
     STATUS DOT (ONLINE INDICATOR)
  ---------------------------------*/
  /* Outer ring with glowing effect */
  .status-dot {
    animation: outerGlow 1.2s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }

  /* Inner dot with pulsing effect */
  .inner-dot {
    animation: pulse 1.2s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }

  /* Keyframe for pulsing inner dot */
  @keyframes pulse {
    0%,
    100% {
      transform: scale(1);
      opacity: 1;
    }
    50% {
      transform: scale(1.5);
      opacity: 0.4;
    }
  }

  /* Keyframe for glowing outer ring */
  @keyframes outerGlow {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgba(0, 128, 0, 0.4);
    }
    50% {
      box-shadow: 0 0 4px 2px rgba(0, 255, 0, 0.4);
    }
  }
</style>
